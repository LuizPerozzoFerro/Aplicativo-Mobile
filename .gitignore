# Regras da raiz: valem para o repositório inteiro, inclusive o prototype/.

# variáveis de ambiente e credenciais
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
google-services.json
GoogleService-Info.plist
local.properties

# pacotes de build
*.apk
*.aab
*.ipa

# dependências
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# pastas nativas geradas pelo prebuild (a configuração vive no app.config.ts)
/android/
/ios/

# saída do Gradle dos módulos nativos locais
/modules/*/android/build/
/modules/*/android/.gradle/

# Native
.kotlin/
*.orig.*

# Metro
.metro-health-check*
*.log

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# typescript
*.tsbuildinfo

# testes
coverage/
