          "value": "case `kind` when 'time' then (`value` glob '[0-2][0-9]:[0-5][0-9]-[0-2][0-9]:[0-5][0-9]' and substr(`value`, 1, 2) <= '23' and substr(`value`, 7, 2) <= '23' and substr(`value`, 1, 5) <> substr(`value`, 7, 5)) when 'weekday' then `value` in ('0', '1', '2', '3', '4', '5', '6') when 'emotion' then `value` in ('boredom', 'loneliness', 'stress', 'anxiety', 'tiredness', 'sadness') else 0 end"
