{
  "name": "quedo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:install": "cd android && gradlew.bat installDebug",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "expo customize tsconfig.json",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "jest",
    "check:manifest": "node scripts/check-manifest.js",
    "e2e": "node scripts/run-maestro.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.22",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.7.1",
    "react": "19.3.0",
    "react-i18next": "^17.1.11",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~58.0.23",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "sql.js": "^1.15.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=24.3 <25"
  },
  "jest": {
    "preset": "jest-expo/android",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/prototype/",
      "<rootDir>/android/",
      "<rootDir>/ios/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/prototype/"
    ],
    "globalSetup": "<rootDir>/jest.global-setup.js",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
