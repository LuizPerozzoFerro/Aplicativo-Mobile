<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!--
    Acesso a dados de uso (experimento A1).
    Nao e uma permissao de runtime: o sistema a trata como "acesso especial" e ela
    so pode ser concedida manualmente pelo usuario em Ajustes. Por isso o
    tools:ignore, que silencia o aviso do lint sobre permissao protegida.
  -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />

  <!--
    Visibilidade de pacotes (Android 11+). Sem esta declaracao o app enxerga uma
    lista filtrada dos outros apps instalados e nao consegue nem ler o nome deles.
    Declarar a intencao MAIN/LAUNCHER mostra apenas apps com icone na gaveta, que
    e o suficiente para o usuario escolher o que monitorar.

    Deliberadamente NAO usamos QUERY_ALL_PACKAGES: o Google Play a classifica como
    permissao sensivel, restrita a lancadores, antivirus e gerenciadores de
    arquivos, e seu uso sem justificativa e motivo de remocao (ver experimento A10).
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <!--
    Experimento A2: servico em primeiro plano para detectar o limite de uso com o
    app fechado.

    O tipo e specialUse porque nenhum dos tipos catalogados pelo Android descreve
    "observar o uso de outros apps". dataSync seria o mais proximo, mas desde o
    Android 15 ele tem teto de 6 horas por dia, o que inviabiliza monitoramento
    continuo.

    specialUse exige a <property> abaixo, cujo texto e lido por um revisor humano
    do Google Play na publicacao. Risco a registrar no A10.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- A9: religar o monitoramento depois de reiniciar o aparelho. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <receiver
      android:name=".BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- A3: botao "Emergência" da notificacao de alerta. -->
    <receiver
      android:name=".NotificationActionReceiver"
      android:exported="false" />

    <service
      android:name=".UsageLimitService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Acompanha o tempo de uso de aplicativos escolhidos pelo proprio usuario, para avisa-lo quando ultrapassar o limite diario que ele definiu. Nenhum dado sai do aparelho." />
    </service>
  </application>
</manifest>
