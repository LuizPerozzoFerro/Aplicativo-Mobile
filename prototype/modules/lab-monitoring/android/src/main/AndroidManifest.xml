<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!--
    Acesso a dados de uso (experimento A1).
    Nao e uma permissao de runtime: o sistema a trata como "acesso especial" e ela
    so pode ser concedida manualmente pelo usuario em Ajustes. Por isso o
    tools:ignore, que silencia o aviso do lint sobre permissao protegida.
  -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />

  <!--
    Visibilidade de pacotes (Android 11+). Sem esta declaracao o app enxerga uma
    lista filtrada dos outros apps instalados e nao consegue nem ler o nome deles.
    Declarar a intencao MAIN/LAUNCHER mostra apenas apps com icone na gaveta, que
    e o suficiente para o usuario escolher o que monitorar.

    Deliberadamente NAO usamos QUERY_ALL_PACKAGES: o Google Play trata o inventario
    de apps instalados como dado sensivel e proibe a permissao ampla quando uma
    consulta direcionada resolve o problema, que e o nosso caso. Ela ainda exige
    formulario proprio no Play Console (politica conferida no A10, em 19/09/2026).
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <!--
    Experimento A2: servico em primeiro plano para detectar o limite de uso com o
    app fechado.

    O tipo e specialUse porque nenhum dos tipos catalogados pelo Android descreve
    "observar o uso de outros apps". dataSync seria o mais proximo, mas desde o
    Android 15 ele tem teto de 6 horas por dia, o que inviabiliza monitoramento
    continuo.

    specialUse exige a <property> abaixo, cujo texto e lido por um revisor humano
    do Google Play na publicacao. Risco a registrar no A10.
  -->
  <!--
    A4 / impacto I-25: permite que a tela do laboratorio se proteja de
    sobreposicoes de terceiros (setHideOverlayWindows), para medir se a nossa
    propria tela de interrupcao ainda aparece. Nivel normal: o sistema concede
    sem pedir nada ao usuario, e e por isso que qualquer app pode fazer o mesmo.
  -->
  <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    A4: notificacao com intent de tela cheia, testada como alternativa a
    sobreposicao (I-25). Desde o Android 14 ela nao e mais concedida na
    instalacao para quem nao e app de chamada ou despertador: o usuario precisa
    ligar em Ajustes, e o Google Play revoga por politica quem nao se encaixa
    (A10). O protótipo checa com NotificationManager.canUseFullScreenIntent.
  -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

  <!-- A9: religar o monitoramento depois de reiniciar o aparelho. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!--
    Experimento A6: VPN local que so enxerga DNS.
    - ACCESS_NETWORK_STATE: acompanhar a rede de verdade e os servidores de DNS
      dela, para onde as consultas sao repassadas. Ja chegava por outra biblioteca,
      mas o codigo da VPN depende dela.
    - FOREGROUND_SERVICE_SYSTEM_EXEMPTED: o tipo de servico em primeiro plano que o
      Android 14+ reserva, entre outros, para apps de VPN configurados nos Ajustes.
  -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

  <application>
    <receiver
      android:name=".BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- A3: botao "Emergência" da notificacao de alerta. -->
    <receiver
      android:name=".NotificationActionReceiver"
      android:exported="false" />

    <!--
      A4, abordagem (b): tela de interrupcao como Activity.
      excludeFromRecents para nao poluir a lista de recentes, e noHistory para
      nao ressurgir quando o usuario voltar ao app monitorado.
    -->
    <activity
      android:name=".InterruptionActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:launchMode="singleTask"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

    <!--
      A6: servico de VPN. BIND_VPN_SERVICE garante que so o sistema se liga a ele,
      e o filtro com a acao android.net.VpnService e como o sistema o encontra
      (guia oficial de VPN). Nao exportado, porque so o sistema precisa chegar a
      ele; se o sistema recusar a ligacao, trocar para exportado (a permissao ja
      restringe o acesso ao sistema).
    -->
    <service
      android:name=".LabVpnService"
      android:exported="false"
      android:permission="android.permission.BIND_VPN_SERVICE"
      android:foregroundServiceType="systemExempted">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
    </service>

    <service
      android:name=".UsageLimitService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Acompanha o tempo de uso de aplicativos escolhidos pelo proprio usuario, para avisa-lo quando ultrapassar o limite diario que ele definiu. Nenhum dado sai do aparelho." />
    </service>
  </application>
</manifest>
